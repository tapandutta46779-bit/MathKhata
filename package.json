{
  "name": "mathkhata",
  "productName": "Math Notebook",
  "private": true,
  "version": "1.0.0-beta.1",
  "description": "A local-first mathematical notebook and research workspace.",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build --mode web",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name=mathkhata --branch=main",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "concurrently -k -s first \"npm run dev\" \"wait-on http://127.0.0.1:4173 && cross-env MATHKHATA_DEV_URL=http://127.0.0.1:4173 electron .\"",
    "desktop:package": "npm run build:desktop && electron-forge package && node scripts/finalize-macos-package.mjs",
    "desktop:make": "npm run desktop:package && electron-forge make --skip-package",
    "desktop:make:mac": "npm run build:desktop && electron-forge package --platform=darwin --arch=arm64 && node scripts/finalize-macos-package.mjs && electron-forge make --skip-package --platform=darwin --arch=arm64",
    "desktop:make:win": "npm run build:desktop && electron-forge make --platform=win32 --arch=x64",
    "desktop:make:linux": "npm run build:desktop && electron-forge make --platform=linux --arch=x64"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "dexie": "4.4.4",
    "mathlive": "0.110.0",
    "nerdamer-prime": "1.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.0",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "image-size": "0.7.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "latest",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-on": "9.0.4",
    "wrangler": "^4.120.1"
  }
}
